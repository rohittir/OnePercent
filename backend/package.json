{
  "name": "onepercent-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "test": "node --env-file=.env.example --test \"**/!(*.int).test.js\"",
    "test:int": "node --env-file=.env.example --test \"**/*.int.test.js\"",
    "dev": "node --env-file=.env.example --env-file-if-exists=.env --watch src/local.js",
    "stack:up": "docker compose up -d --wait dynamodb",
    "stack:down": "docker compose down",
    "build": "node scripts/build.js",
    "synth": "npm run build && node infra/bin/app.js",
    "deploy": "npm run build && cdk deploy --all"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@onepercent/shared": "file:../shared",
    "dynamodb-onetable": "^2.7.7",
    "lambda-api": "^1.5.1"
  },
  "devDependencies": {
    "aws-cdk": "^2.1147.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2"
  }
}
